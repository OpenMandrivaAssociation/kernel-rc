+
+extern int sti7109_cmd_init(struct sti7109_dev *sti7109);
+extern int sti7109_raw_cmd(struct sti7109_dev *sti7109,
+			   osd_raw_cmd_t __user *user_cmdp);
+extern int sti7109_raw_data(struct sti7109_dev *sti7109,
