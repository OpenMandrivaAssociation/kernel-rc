615.78.08 already declares __to_hwgpio() with a non-const gpio_device *,
which is what gpio_device_get_chip() takes. Keep that constraint visible
in-tree: clang -Werror fails on aarch64 (CONFIG_OF_GPIO) if const returns.

--- a/kernel-open/common/inc/nv-linux.h
+++ b/kernel-open/common/inc/nv-linux.h
@@ -1769,6 +1769,7 @@
 #include <linux/of_gpio.h>
 #else
 #include <linux/gpio/driver.h>
+/* gpio_device_get_chip() takes a non-const gpio_device *. */
 
 static inline int __to_hwgpio(struct gpio_device *gdev,
                               const struct of_phandle_args *gpiospec)
