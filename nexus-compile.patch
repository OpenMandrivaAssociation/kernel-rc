 		goto out_dput;
 	}
 
-	ret = vfs_create(&nop_mnt_idmap, d_inode(parent_path.dentry),
-			 marker_dentry, 0644, false);
+	ret = vfs_create(&nop_mnt_idmap, marker_dentry, 0644, NULL);
 	if (ret)
 		goto out_dput;
 
@@ -403,8 +419,12 @@ long nexus_index_ioctl_remove(unsigned l
 
 	inode_lock(d_inode(parent_path.dentry));
 
-	marker_dentry = lookup_one_len(req.name, parent_path.dentry,
-				       strlen(req.name));
+	{
+		struct qstr q = QSTR_INIT(req.name, strlen(req.name));
+
+		marker_dentry = lookup_one(&nop_mnt_idmap, &q,
+					   parent_path.dentry);
+	}
 	if (IS_ERR(marker_dentry)) {
 		ret = PTR_ERR(marker_dentry);
 		goto out_parent_unlock;
