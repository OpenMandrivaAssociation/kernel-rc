615.78.08 picks the 7.3 dmem_cgroup_register_region() prototype
(const struct dmem_cgroup_init *, printf-style name) via conftest, but
passes the region name through as the format string. A name containing
'%' is not a literal format. Pass it with "%s".

--- a/kernel-open/nvidia/os-interface.c
+++ b/kernel-open/nvidia/os-interface.c
@@ -3052,9 +3052,9 @@
     {
         .size = size,
     };
-    region = dmem_cgroup_register_region(&init, name);
+    region = dmem_cgroup_register_region(&init, "%s", name);
 #else
-    region = dmem_cgroup_register_region(size, name);
+    region = dmem_cgroup_register_region(size, "%s", name);
 #endif
     if (IS_ERR(region))
     {
